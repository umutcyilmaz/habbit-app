{
  "name": "tms",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8082",
    "start:e2e": "APP_VARIANT=e2e EXPO_PUBLIC_E2E_MODE=1 expo start --dev-client --localhost --port 8082",
    "ios": "expo start --ios --port 8082",
    "ios:e2e": "APP_VARIANT=e2e expo prebuild --platform ios && APP_VARIANT=e2e EXPO_PUBLIC_E2E_MODE=1 expo run:ios --port 8082",
    "ios:e2e:rebuild": "APP_VARIANT=e2e expo prebuild --clean --platform ios",
    "android": "expo start --android --port 8082",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "verify:kegel:persistence": "node scripts/run-bloom-kegel-persistence-verification.cjs",
    "verify:kegel": "node scripts/verify-bloom-kegel.cjs",
    "verify:reset-continuity": "node scripts/run-bloom-reset-continuity-verification.cjs",
    "verify:persistence": "node scripts/run-bloom-persistence-verification.cjs",
    "verify:persistence-acknowledgement": "node scripts/run-bloom-persistence-acknowledgement-verification.cjs",
    "verify:quiz": "node scripts/run-bloom-quiz-verification.cjs",
    "verify:onboarding": "node scripts/run-bloom-onboarding-verification.cjs",
    "verify:product-onboarding-ui": "node scripts/run-bloom-product-onboarding-ui-verification.cjs",
    "verify:journey": "node scripts/run-bloom-journey-verification.cjs",
    "verify:protection-reset": "node scripts/run-bloom-protection-reset-verification.cjs",
    "verify:guided-flows": "node scripts/run-bloom-guided-flows-verification.cjs",
    "verify:counter-history": "node scripts/run-bloom-counter-history-verification.cjs",
    "verify:home-ui": "node scripts/run-bloom-home-ui-verification.cjs",
    "verify:e2e-runtime": "node scripts/run-bloom-e2e-runtime-verification.cjs",
    "verify:e2e-app-identity": "node scripts/verify-bloom-e2e-app-identity.cjs",
    "verify:release-debug-guards": "node scripts/verify-bloom-release-debug-guards.cjs",
    "maestro:smoke": "maestro test .maestro/onboarding-smoke.yaml",
    "maestro:onboarding": "maestro test .maestro/onboarding-general.yaml",
    "maestro:check-in": "maestro test .maestro/check-in-save.yaml",
    "maestro:protection": "maestro test .maestro/protection-setup.yaml",
    "maestro:pause": "maestro test .maestro/pause-entry.yaml",
    "maestro:arousal": "maestro test .maestro/arousal-entry.yaml",
    "maestro:pause-complete": "maestro test .maestro/pause-complete.yaml",
    "maestro:reset-complete": "maestro test .maestro/reset-complete.yaml",
    "maestro:arousal-complete": "maestro test .maestro/arousal-complete.yaml",
    "maestro:core": "maestro test .maestro/protection-setup.yaml .maestro/pause-entry.yaml .maestro/arousal-entry.yaml",
    "maestro:terminal": "maestro test .maestro/pause-complete.yaml .maestro/reset-complete.yaml .maestro/arousal-complete.yaml",
    "maestro:all": "maestro test .maestro/onboarding-smoke.yaml .maestro/onboarding-general.yaml .maestro/check-in-save.yaml .maestro/protection-setup.yaml .maestro/pause-entry.yaml .maestro/arousal-entry.yaml .maestro/pause-complete.yaml .maestro/reset-complete.yaml .maestro/arousal-complete.yaml",
    "start:e2e:phase10": "APP_VARIANT=e2e EXPO_PUBLIC_E2E_MODE=1 EXPO_PUBLIC_PHASE10_QA=1 expo start --dev-client --localhost --port 8082",
    "start:e2e:kegel:persistence": "node scripts/require-kegel-qa-run.cjs && APP_VARIANT=e2e EXPO_PUBLIC_E2E_MODE=1 EXPO_PUBLIC_KEGEL_PERSISTENCE_QA=1 expo start --dev-client --localhost --port 8082",
    "start:e2e:kegel": "APP_VARIANT=e2e EXPO_PUBLIC_E2E_MODE=1 EXPO_PUBLIC_KEGEL_PREVIEW=1 expo start --dev-client --localhost --port 8082",
    "verify:profile": "node scripts/run-bloom-profile-verification.cjs",
    "verify:library": "node scripts/run-bloom-library-verification.cjs",
    "verify:navigation": "node scripts/verify-bloom-four-tabs.cjs",
    "postinstall": "node scripts/patch-expo-audio-ios.cjs",
    "verify:audio": "node scripts/run-bloom-audio-verification.cjs",
    "verify:settings": "node scripts/verify-bloom-settings.cjs",
    "start:e2e:practice": "APP_VARIANT=e2e EXPO_PUBLIC_E2E_MODE=1 EXPO_PUBLIC_PRACTICE_PREVIEW=1 expo start --dev-client --localhost --port 8082",
    "verify:practice": "node scripts/run-bloom-practice-verification.cjs && node scripts/verify-bloom-practice-ui.cjs",
    "verify:practice:persistence": "node scripts/run-bloom-practice-persistence-verification.cjs && node scripts/verify-bloom-practice-integration.cjs",
    "start:e2e:practice:persistence": "node scripts/require-practice-qa-run.cjs && APP_VARIANT=e2e EXPO_PUBLIC_E2E_MODE=1 EXPO_PUBLIC_PRACTICE_PERSISTENCE_QA=1 expo start --dev-client --localhost --port 8082",
    "start:e2e:urge-preview": "APP_VARIANT=e2e EXPO_PUBLIC_E2E_MODE=1 EXPO_PUBLIC_URGE_PREVIEW=1 expo start --dev-client --localhost --port 8084",
    "verify:urge-preview": "node scripts/verify-bloom-urge-preview.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "1.1.1",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
