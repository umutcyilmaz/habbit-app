{
  "name": "tms",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8082",
    "start:e2e": "EXPO_PUBLIC_E2E_MODE=1 expo start --dev-client --port 8082",
    "ios": "expo start --ios --port 8082",
    "android": "expo start --android --port 8082",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "verify:persistence": "node scripts/run-bloom-persistence-verification.cjs",
    "verify:quiz": "node scripts/run-bloom-quiz-verification.cjs",
    "verify:journey": "node scripts/run-bloom-journey-verification.cjs",
    "verify:protection-reset": "node scripts/run-bloom-protection-reset-verification.cjs",
    "verify:guided-flows": "node scripts/run-bloom-guided-flows-verification.cjs",
    "verify:e2e-runtime": "node scripts/run-bloom-e2e-runtime-verification.cjs",
    "verify:release-debug-guards": "node scripts/verify-bloom-release-debug-guards.cjs",
    "maestro:smoke": "maestro test .maestro/onboarding-smoke.yaml",
    "maestro:onboarding": "maestro test .maestro/onboarding-general.yaml",
    "maestro:protection": "maestro test .maestro/protection-setup.yaml",
    "maestro:pause": "maestro test .maestro/pause-entry.yaml",
    "maestro:arousal": "maestro test .maestro/arousal-entry.yaml",
    "maestro:pause-complete": "maestro test .maestro/pause-complete.yaml",
    "maestro:reset-complete": "maestro test .maestro/reset-complete.yaml",
    "maestro:arousal-complete": "maestro test .maestro/arousal-complete.yaml",
    "maestro:core": "maestro test .maestro/protection-setup.yaml .maestro/pause-entry.yaml .maestro/arousal-entry.yaml",
    "maestro:terminal": "maestro test .maestro/pause-complete.yaml .maestro/reset-complete.yaml .maestro/arousal-complete.yaml",
    "maestro:all": "maestro test .maestro/onboarding-smoke.yaml .maestro/onboarding-general.yaml .maestro/protection-setup.yaml .maestro/pause-entry.yaml .maestro/arousal-entry.yaml .maestro/pause-complete.yaml .maestro/reset-complete.yaml .maestro/arousal-complete.yaml"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
